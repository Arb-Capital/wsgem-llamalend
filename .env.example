# Signing. Use a keystore -- never a raw private key.
ETH_FROM=0x
ETH_KEYSTORE=/path/to/keystore
ETHERSCAN_API_KEY=

# Mainnet. Required for deploys and for `make test-fork`.
ETH_RPC_URL=
ETH_FORK_BLOCK=25670300
# Gas overrides. Both optional -- leave them COMMENTED OUT and forge estimates. Do not leave them
# set-but-empty: forge reads ETH_GAS_PRICE from the environment directly, and an empty value is a
# parse error, not an absence. When set, ETH_PRIO_FEE becomes --priority-gas-price and
# ETH_GAS_PRICE becomes --with-gas-price (max fee per gas on the broadcast transaction). NOT
# --base-fee: that is an alias for --block-base-fee-per-gas, which only sets the base fee of the
# simulated block and does not price what you send.
# ETH_PRIO_FEE=
# ETH_GAS_PRICE=

# The already-deployed oracle shim the market deploy builds on. REQUIRED for a broadcast: the
# oracle is deployed first and watched across a publication before the market depends on it
# (docs/05 step 2), so `make market-deploy` refuses without this and the script itself reverts
# on any broadcast where it is unset. Only the dry run may leave it unset, which simulates
# deploying a fresh oracle in the same run.
#
# Whatever is set here is validated against the configured wsgem, gem, feed and speed before any
# transaction is broadcast. The factory cannot do that check: an oracle built for a different asset
# satisfies its only requirements. Empty and unset are equivalent.
# WSGEM_ORACLE=

# The deployed rate calculator. Only `make poke` reads it -- the market deploy creates the
# calculator itself. Set both this and WSGEM_ORACLE to run the daily keeper (docs/07).
# WSGEM_CALC=
